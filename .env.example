# Gemini Flash — script generation + feedback
# (gemini-2.5-flash is blocked for many new keys; default model is gemini-flash-latest)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Groq Whisper — speech-to-text during rehearsal
GROQ_WHISPER_API_KEY=

# Groq LLM — questioning / objections
GROQ_LLM_API_KEY=

# OpenAI — text-to-speech (browser voice is used as fallback)
OPENAI_API_KEY=

PORT=3000
